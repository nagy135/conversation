{
  "name": "conversation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.87.1",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "vite": "8.3.0"
  }
}
